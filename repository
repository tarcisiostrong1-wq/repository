<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>STP Energia | Inteligência Técnica, Conformidade Regulatória & Conteúdo Local</title>
  <style>
    :root {
      --primary: #0b1f3a;
      --secondary: #163a63;
      --accent: #c59b27;
      --bg: #f8fafc;
      --surface: #ffffff;
      --text: #1e293b;
      --muted: #475569;
      --border: #e2e8f0;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html {
      scroll-behavior: smooth;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.65;
    }

    /* Navegação */
    header {
      background-color: var(--primary);
      color: #ffffff;
      position: sticky;
      top: 0;
      z-index: 1000;
      border-bottom: 3px solid var(--accent);
    }
    .nav-container {
      max-width: 1120px;
      margin: 0 auto;
      padding: 0.95rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.85rem;
    }
    .brand {
      font-weight: 700;
      font-size: 1.15rem;
      letter-spacing: 0.5px;
      cursor: pointer;
    }
    .brand span {
      color: var(--accent);
      font-weight: 400;
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.15rem;
      flex-wrap: wrap;
    }
    .nav-links a {
      color: #e2e8f0;
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 500;
      cursor: pointer;
      transition: color 0.2s;
    }
    .nav-links a:hover {
      color: var(--accent);
    }
    .lang-toggle {
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: #ffffff;
      padding: 0.4rem 0.9rem;
      border-radius: 4px;
      cursor: pointer;
      font-weight: 600;
      font-size: 0.85rem;
      transition: all 0.2s;
    }
    .lang-toggle:hover {
      background: var(--accent);
      color: var(--primary);
      border-color: var(--accent);
    }

    /* Banner Principal */
    .hero {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      color: #ffffff;
      padding: 4.25rem 1.5rem;
    }
    .hero-inner {
      max-width: 1120px;
      margin: 0 auto;
    }
    .badge {
      display: inline-block;
      background: rgba(197, 155, 39, 0.2);
      border: 1px solid var(--accent);
      color: #fde68a;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 0.3rem 0.75rem;
      border-radius: 3px;
      margin-bottom: 1.15rem;
    }
    .hero h1 {
      font-size: 2.25rem;
      line-height: 1.2;
      margin-bottom: 1rem;
      max-width: 880px;
    }
    .hero p {
      font-size: 1.06rem;
      color: #cbd5e1;
      max-width: 820px;
      margin-bottom: 1.85rem;
    }
    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      font-size: 0.9rem;
      color: #e2e8f0;
      border-top: 1px solid rgba(255,255,255,0.15);
      padding-top: 1.15rem;
    }
    .hero-meta strong { color: var(--accent); }
    .hero-meta a {
      color: #e2e8f0;
      text-decoration: none;
    }
    .hero-meta a:hover {
      text-decoration: underline;
    }

    /* Conteúdo Principal (Página Única) */
    main {
      max-width: 1120px;
      margin: 0 auto;
      padding: 3rem 1.5rem;
    }
    section {
      margin-bottom: 4.25rem;
      scroll-margin-top: 90px;
    }
    .section-title {
      font-size: 1.45rem;
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 0.75px;
      border-left: 4px solid var(--accent);
      padding-left: 0.85rem;
      margin-bottom: 0.65rem;
    }
    .section-subtitle {
      color: var(--muted);
      font-size: 0.98rem;
      margin-bottom: 1.65rem;
      max-width: 860px;
    }

    /* Cartão Visão Geral */
    .summary-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 2rem;
      box-shadow: 0 2px 6px rgba(0,0,0,0.03);
    }
    .summary-card p + p {
      margin-top: 1rem;
    }

    /* Cartões de Pilares e Competências */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
      gap: 1.5rem;
    }
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-top: 3px solid var(--primary);
      border-radius: 6px;
      padding: 1.65rem;
      box-shadow: 0 2px 6px rgba(0,0,0,0.03);
    }
    .card.accent-top {
      border-top: 3px solid var(--accent);
    }
    .pillar-tag {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--secondary);
      background: #eff6ff;
      padding: 0.2rem 0.55rem;
      border-radius: 3px;
      margin-bottom: 0.65rem;
    }
    .card h3 {
      color: var(--primary);
      font-size: 1.1rem;
      margin-bottom: 0.85rem;
    }
    .sub-item {
      margin-bottom: 0.85rem;
    }
    .sub-item:last-child {
      margin-bottom: 0;
    }
    .sub-item strong {
      display: block;
      color: var(--primary);
      font-size: 0.94rem;
      margin-bottom: 0.15rem;
    }
    .sub-item p {
      color: var(--muted);
      font-size: 0.91rem;
    }

    /* Perfil de Liderança */
    .leader-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-left: 4px solid var(--accent);
      border-radius: 6px;
      padding: 2rem;
      box-shadow: 0 2px 6px rgba(0,0,0,0.03);
    }
    .leader-header {
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.85rem;
      margin-bottom: 1.25rem;
    }
    .leader-header h3 {
      color: var(--primary);
      font-size: 1.3rem;
    }
    .leader-header span {
      color: var(--secondary);
      font-weight: 600;
      font-size: 0.95rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .cred-list {
      list-style: none;
    }
    .cred-list li {
      position: relative;
      padding-left: 1.25rem;
      margin-bottom: 0.9rem;
      font-size: 0.95rem;
    }
    .cred-list li::before {
      content: "▪";
      color: var(--accent);
      position: absolute;
      left: 0;
      font-weight: bold;
    }
    .cred-list li strong {
      color: var(--primary);
    }

    /* Linha do Tempo / Tração */
    .timeline {
      border-left: 3px solid var(--secondary);
      padding-left: 1.5rem;
      margin-left: 0.5rem;
    }
    .timeline-item {
      position: relative;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1.35rem 1.5rem;
      margin-bottom: 1.25rem;
      box-shadow: 0 2px 5px rgba(0,0,0,0.02);
    }
    .timeline-item::before {
      content: "";
      position: absolute;
      left: -1.95rem;
      top: 1.55rem;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--accent);
      border: 2px solid var(--primary);
    }
    .timeline-date {
      font-size: 0.82rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--secondary);
      letter-spacing: 0.5px;
      margin-bottom: 0.3rem;
    }
    .timeline-item h3 {
      color: var(--primary);
      font-size: 1.05rem;
      margin-bottom: 0.45rem;
    }
    .timeline-item p {
      color: var(--muted);
      font-size: 0.94rem;
    }

    /* Rodapé / Contacto */
    footer {
      background: var(--primary);
      color: #cbd5e1;
      padding: 3.5rem 1.5rem;
      border-top: 3px solid var(--accent);
      scroll-margin-top: 90px;
    }
    .footer-inner {
      max-width: 1120px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 2rem;
    }
    .footer-inner h4 {
      color: #ffffff;
      margin-bottom: 0.75rem;
      font-size: 1.08rem;
    }
    .footer-inner p {
      font-size: 0.92rem;
      margin-bottom: 0.35rem;
    }
    .footer-inner a {
      color: #fde68a;
      text-decoration: none;
    }
    .footer-inner a:hover {
      text-decoration: underline;
    }

    /* Visibilidade de Idiomas (Português ativo por padrão) */
    [data-lang="en"] { display: none; }
    body.en [data-lang="pt"] { display: none; }
    body.en [data-lang="en"] { display: block; }
    body.en a[data-lang="en"],
    body.en span[data-lang="en"],
    body.en strong[data-lang="en"] { display: inline; }
    body.en .grid[data-lang="en"] { display: grid; }

    @media (max-width: 768px) {
      .hero h1 { font-size: 1.75rem; }
      .summary-card, .leader-card { padding: 1.35rem; }
      .nav-links { gap: 0.75rem; }
      .nav-links a { font-size: 0.82rem; }
    }
  </style>
</head>
